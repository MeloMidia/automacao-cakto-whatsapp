# Servidor
PORT=3000
DATABASE_PATH=./data/automation.sqlite
LOG_LEVEL=info

# Cakto: use exatamente o segredo configurado no webhook
CAKTO_WEBHOOK_SECRET=troque-por-um-segredo-forte
# Opcional, mas recomendado: IDs separados por vírgula. Vazio aceita qualquer produto.
CAKTO_ALLOWED_PRODUCT_IDS=
# Por padrão, order bumps/upsells não geram outro convite.
CAKTO_MAIN_PRODUCT_ONLY=true

# Evolution API — podem ser as mesmas credenciais usadas pelo sistemaMelo
EVOLUTION_API_URL=https://sua-evolution-api.exemplo.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=sistemamelo
# Intervalo entre mensagens para evitar disparos em rajada
EVOLUTION_MIN_SEND_INTERVAL_MS=7000

WHATSAPP_GROUP_INVITE_URL=https://chat.whatsapp.com/SEU_CODIGO_DE_CONVITE

# true registra o envio sem chamar o WhatsApp (ideal para o primeiro teste)
DRY_RUN=true
MAX_SEND_ATTEMPTS=5
